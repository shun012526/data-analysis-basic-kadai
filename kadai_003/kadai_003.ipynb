        "import numpy as np\n",
        "a = np.array([[0, 1],\n",
        "             [2, 3],\n",
        "             [4, 5]])\n",
        "\n",
        "b = np.array([[0, 1, 2, 3],\n",
        "             [4, 5, 6, 7]])\n",
        "\n",
        "dot_array = np.dot(a, b)\n",
        "print(dot_array)\n",
        "\n",
        "print(dot_array.max())\n"
      ]
